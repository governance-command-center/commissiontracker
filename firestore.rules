rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function pilot() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // Basic pilot gate only: browser-side roles cannot enforce database authorization.
    // Anyone who obtains an anonymous session can bypass the UI. Scope stays isolated.
    match /commissionPilotUsers/{id} { allow read, create, update: if pilot(); allow delete: if false; }
    match /commissionPilotCredentials/{id} { allow read, create, update: if pilot(); allow delete: if false; }
    match /commissionPilotEvents/{id} { allow read, create: if pilot(); allow update, delete: if false; }
    match /commissionPilotMeta/{id} { allow read, create, update: if pilot(); allow delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
